# Copy this file to ".env.local" for local development. Never commit .env.local.
# Everything here is PUBLIC configuration: Vite copies VITE_* values into the
# built JavaScript, where any visitor can read them. Do not put passwords,
# API keys, or other private credentials in these variables.

# The public Formspree form ID (the part after https://formspree.io/f/).
# It identifies the form; it is not an account API key.
# Leave empty to show the "signup unavailable" state.
VITE_FORMSPREE_FORM_ID=

# The final public address of the site, with a trailing slash. Used only for
# the canonical link and social sharing tags. Leave empty until the site is
# deployed and you have confirmed the address works.
# Example: https://USERNAME.github.io/REPOSITORY/healthy-steps/
VITE_SITE_URL=

# Demo events appear automatically in "npm run dev". Set this to "true" only
# if you need to preview them in a production build on your own machine.
# Never set it in the GitHub Actions workflow.
VITE_SHOW_DEMO_EVENTS=

# Path the site is served from (read by vite.config.ts, not by the browser).
# The default "./" works at any address. The deploy workflow sets it
# explicitly; you normally do not need to.
# Project site in a sub-folder:  /REPOSITORY/healthy-steps/
# Project site at repo root:     /REPOSITORY/
# User site or custom domain:    /
SITE_BASE_PATH=
